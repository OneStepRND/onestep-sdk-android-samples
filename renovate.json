{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Bump the OneStep SDK in all three samples in one PR, as soon as it ships.",
      "matchPackageNames": ["co.onestep.android:*"],
      "groupName": "OneStep SDK",
      "schedule": ["at any time"]
    },
    {
      "description": "AGP, Kotlin and Gradle move together across the samples.",
      "matchPackageNames": ["com.android.application", "org.jetbrains.kotlin.*", "gradle"],
      "groupName": "Android toolchain"
    },
    {
      "description": "Keep AndroidX and Compose updates in one weekly PR.",
      "matchPackageNames": ["androidx.*", "com.google.accompanist:*"],
      "groupName": "AndroidX"
    },
    {
      "description": "GitHub Actions in one PR.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
